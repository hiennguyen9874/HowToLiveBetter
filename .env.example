# Local secrets for LLM translation waves (OpenAI-compatible).
# Copy to .env and fill in. .env is gitignored — do not commit it.
#
#   cp .env.example .env

# Required when translate/llm adapter is used (local llama-server: any non-empty string)
HTLB_LLM_API_KEY=local

# --- Existing local Gemma server (llama.cpp); do not start a second server ---
HTLB_LLM_BASE_URL=http://127.0.0.1:8080/v1
HTLB_LLM_MODEL=gemma-4-31b-qat
# For Hy-MT2 instead: set the exact model ID returned by /v1/models.
# Factual unit translation; card default 0.7 is creative — keep low for HTLB
HTLB_LLM_TEMPERATURE=0.2
# Includes reasoning tokens on servers that count them toward completion.

HTLB_LLM_MAX_TOKENS=32768
HTLB_LLM_TIMEOUT=600
# Existing Gemma: keep its server running; input + completion must fit per-slot context.
# Hy-MT2 only: translate/steps/translate/start-llama-server.sh (default -c 16384).
# HTLB_LLAMA_CTX=16384

# LanguageTool (translate/shelf/lt_check.py / make lt) — required after verify
# HTLB_LT_BASE_URL=http://127.0.0.1:8010

# Laya System-1 (translate/laya/) — required for make polish / clarity
# HTLB_LAYA_BASE_URL=http://127.0.0.1:8090
# HTLB_LAYA_PORT=8090
# HTLB_LAYA_MODEL=multilingual
# HTLB_LAYA_DEVICE=mps
